{
  "sectionmodel": {
    "type": "label",
    "value": "型号"
  },
  "model": {
    "text": "阵列型号",
    "type": "dropdown",
    "value": 3,
    "items": [
      "ClockClock 24 · 8 × 3",
      "A million Times 72 · 12 × 6",
      "A million Times 120 · 15 × 8",
      "A million Times 144 · 18 × 8",
      "A million Times 288 · 24 × 12"
    ]
  },
  "sectionpalette": {
    "type": "label",
    "value": "配色方案"
  },
  "preset": {
    "text": "配色方案",
    "type": "dropdown",
