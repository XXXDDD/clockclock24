      "自定义（使用下方独立颜色）",
      "经典黑",
      "经典白",
      "苔原",
      "纸与墨",
      "暮色",
      "深海",
      "赤陶",
      "午夜"
    ],
    "help": "想单独修改背景或指针颜色，请选择自定义。"
  },
  "sectioncolors": {
    "type": "label",
    "value": "独立颜色（自定义配色时生效）"
  },
  "background": {
    "text": "画布背景",
    "type": "color",
    "value": "#000000"
  },
  "board": {
    "text": "背景板",
    "type": "color",
    "value": "#111213"
  },
  "long": {
    "text": "长针",
    "type": "color",
    "value": "#f9faf7"
  },
  "short": {
    "text": "短针",
    "type": "color",
    "value": "#eef0ec"
  },
  "sectionscreen": {
    "type": "label",
    "value": "大小与位置"
  },
  "scale": {
    "text": "整体缩放（%）",
    "type": "slider",
    "value": 90,
    "min": 20,
    "max": 100,
    "step": 1
  },
  "padding": {
    "text": "画布安全边距（px）",
    "type": "slider",
    "value": 0,
    "min": 0,
    "max": 160,
    "step": 1
  },
  "offsetX": {
    "text": "水平位置（%）",
    "type": "slider",
    "value": 0,
    "min": -100,
    "max": 100,
    "step": 1
  },
  "offsetY": {
    "text": "垂直位置（%）",
    "type": "slider",
    "value": 0,
    "min": -100,
    "max": 100,
    "step": 1
  },
  "sectiongeometry": {
    "type": "label",
    "value": "表盘与指针"
  },
  "radius": {
    "text": "表盘半径（设计单位）",
    "type": "textbox",
    "value": "43",
    "help": "有效范围 20–65，可输入小数。"
  },
  "gap": {
    "text": "表盘间隙（设计单位）",
    "type": "textbox",
    "value": "4.3",
    "help": "有效范围 0–40，可输入小数。"
  },
  "longLength": {
    "text": "长针长度（%）",
    "type": "slider",
    "value": 100,
    "min": 70,
    "max": 100,
    "step": 1
  },
  "shortLength": {
    "text": "短针长度（%）",
    "type": "slider",
    "value": 85,
    "min": 55,
    "max": 100,
    "step": 1,
    "help": "相对本型号原作长针基准；默认 85%，保留实物的长短针差异。"
  },
  "longWidth": {
    "text": "长针粗细（设计单位）",
    "type": "textbox",
    "value": "6.2",
    "help": "有效范围 2–14，可输入小数。"
  },
  "shortWidth": {
    "text": "短针粗细（设计单位）",
    "type": "textbox",
    "value": "6.2",
    "help": "有效范围 2–14，可输入小数。"
  },
  "sectionmotion": {
    "type": "label",
    "value": "动画与播放"
  },
  "motion": {
    "text": "换时动画",
    "type": "dropdown",
    "value": 0,
    "items": [
      "逐列波浪收束",
      "同步旋转",
      "平滑过渡",
      "立即换时"
    ]
  },
  "duration": {
    "text": "动画时长（s）",
    "type": "textbox",
    "value": "6",
    "help": "有效范围 1–10，可输入小数。"
  },
  "visibility": {
    "text": "闲置指针",
    "type": "dropdown",
    "value": 2,
    "items": [
      "随归位隐藏",
      "微光显示",
      "全部显示"
    ],
    "help": "仅闲置表盘的双针一起随动作显隐；参与数字或冒号的双针完整保留，包括折叠的指针。"
  },
  "playbackSpeed": {
    "text": "调试播放速度（倍）",
    "type": "textbox",
    "value": "1",
    "help": "有效范围 0.1–3，可输入小数。"
  },
  "paused": {
    "text": "暂停播放（验证用）",
    "type": "checkbox",
    "value": false
  },
  "sectiontime": {
    "type": "label",
    "value": "时间"
  },
  "format24": {
    "text": "24 小时制",
    "type": "checkbox",
    "value": true
  },
  "timezone": {
    "text": "时区",
    "type": "textbox",
    "value": "",
    "help": "留空跟随设备，例如 Asia/Hong_Kong。"
  },
  "source": {
    "text": "时间来源",
    "type": "dropdown",
    "value": 0,
    "items": [
      "设备时间",
      "指定时间"
    ]
  },
  "manualTime": {
    "text": "指定时间",
    "type": "textbox",
    "value": "12:38",
    "help": "指定时间模式使用，格式 HH:MM，例如 09:34。"
  },
  "autoDemo": {
    "text": "指定时间自动逐分钟切换",
    "type": "checkbox",
    "value": false
  },
  "demoInterval": {
    "text": "自动切换间隔（s）",
    "type": "textbox",
    "value": "5",
    "help": "有效范围 1–20，可输入小数。"
  }
}
