  "sectionscreen": {
    "type": "label",
    "value": "Size and position"
  },
  "borderless": {
    "text": "Borderless board",
    "type": "checkbox",
    "value": true,
    "help": "Automatically fit and enlarge the dials on a full-screen board. Background, size, margin and position settings are ignored while enabled."
  },
  "scale": {
    "text": "Size (%)",
    "type": "slider",
    "value": 90,
    "min": 20,
    "max": 100,
    "step": 1
  },
  "padding": {
    "text": "Safe margin (px)",
    "type": "slider",
    "value": 0,
    "min": 0,
    "max": 160,
    "step": 1
  },
  "offsetX": {
    "text": "Horizontal position (%)",
    "type": "slider",
    "value": 0,
    "min": -100,
    "max": 100,
    "step": 1
  },
  "offsetY": {
    "text": "Vertical position (%)",
    "type": "slider",
    "value": 0,
    "min": -100,
    "max": 100,
    "step": 1
  },
  "sectioncolors": {
    "type": "label",
    "value": "Colors"
  },
  "customColors": {
    "text": "Use custom colors",
    "type": "checkbox",
    "value": false,
    "help": "Off uses the selected design's original colors. Turn on to use the four colors below."
  },
  "background": {
    "text": "Background",
    "type": "color",
    "value": "#000000"
  },
  "board": {
    "text": "Clock face",
    "type": "color",
    "value": "#111213"
  },
  "long": {
    "text": "Long hand",
    "type": "color",
    "value": "#f9faf7"
  },
  "short": {
    "text": "Short hand",
    "type": "color",
    "value": "#eef0ec"
  },
  "sectionmotion": {
    "type": "label",
    "value": "Motion and playback"
  },
  "action": {
    "text": "Motion",
    "type": "dropdown",
    "value": 0,
    "items": [
      "Original motion",
      "24 series · Staggered rotation",
      "24 series · Diagonal wave",
      "24 series · Tidal wave",
      "AMT 72 · Radial ripples",
      "AMT 72 · Horizontal wind",
      "AMT 72 · Diagonal wave",
      "AMT 61c · Flowing wind · Zephyr",
      "AMT 61c · Circular waves · Tidal",
      "AMT 72v · Phased rotation · Two-speed settling",
      "AMT 72v · Diagonal wave"
    ],
    "help": "Uses the original motion by default. Extra motions apply only to the model named in the option."
  },
  "customDuration": {
    "text": "Use custom motion duration",
    "type": "checkbox",
    "value": false,
    "help": "Off uses the reference duration for the selected design or motion."
  },
  "duration": {
    "text": "Motion duration (s)",
    "type": "textbox",
    "value": "54.4",
    "help": "Applies when custom motion duration is enabled."
  },
  "visibility": {
    "text": "Idle hands",
    "type": "dropdown",
    "value": 0,
    "items": [
      "Original setting",
      "Hide after settling",
      "Dim idle hands",
      "Show all hands"
    ],
    "help": "Both hands on idle dials fade together. Hands that form the time remain visible, including overlapping hands."
  },
  "playbackSpeed": {
    "text": "Playback speed (×)",
    "type": "textbox",
    "value": "1"
  },
  "paused": {
    "text": "Pause",
    "type": "checkbox",
    "value": false
  },
  "sectiontime": {
    "type": "label",
    "value": "Time"
  },
  "format24": {
    "text": "24-hour time",
    "type": "checkbox",
    "value": true
  },
  "timezone": {
    "text": "Time zone",
    "type": "textbox",
    "value": "",
    "help": "Leave blank to follow your device, for example Asia/Hong_Kong."
  },
  "source": {
    "text": "Time source",
    "type": "dropdown",
    "value": 0,
    "items": [
      "Device time",
      "Set time"
    ]
  },
  "manualTime": {
    "text": "Set time",
    "type": "textbox",
    "value": "09:34"
  },
  "autoDemo": {
    "text": "Advance one minute automatically",
    "type": "checkbox",
    "value": false
  },
  "demoInterval": {
    "text": "Demo interval (s)",
    "type": "textbox",
    "value": "5",
    "help": "The complete motion finishes and holds the time for at least 2 seconds before advancing another minute."
  },
  "sectiongeometry": {
    "type": "label",
    "value": "Dimensions and hands"
  },
  "customGeometry": {
    "text": "Customize dimensions and hands",
    "type": "checkbox",
    "value": false,
    "help": "Off uses each design's original dimensions and hand proportions. Turn on to use the values below."
  },
  "radius": {
    "text": "Dial radius (design units)",
    "type": "textbox",
    "value": "43",
    "help": "Applies when custom dimensions are enabled. Values are limited to the selected model's supported range."
  },
  "gap": {
    "text": "Dial spacing (design units)",
    "type": "textbox",
    "value": "5.3",
    "help": "Applies when custom dimensions are enabled. Values are limited to the selected model's supported range."
  },
  "longLength": {
    "text": "Long hand length (%)",
    "type": "slider",
    "value": 100,
    "min": 70,
    "max": 100,
    "step": 1,
    "help": "Applies when custom dimensions are enabled. Values are limited to the selected model's supported range."
  },
  "shortLength": {
    "text": "Short hand length (%)",
    "type": "slider",
    "value": 85,
    "min": 55,
    "max": 100,
    "step": 1,
    "help": "Applies when custom dimensions are enabled. Values are limited to the selected model's supported range."
  },
  "longWidth": {
    "text": "Long hand width (design units)",
    "type": "textbox",
    "value": "8.2",
    "help": "Applies when custom dimensions are enabled. Values are limited to the selected model's supported range."
  },
  "shortWidth": {
    "text": "Short hand width (design units)",
    "type": "textbox",
    "value": "8.2",
    "help": "Applies when custom dimensions are enabled. Values are limited to the selected model's supported range."
  },
  "centerHourLength": {
    "text": "Center hour hand ratio (%)",
    "type": "slider",
    "value": 98,
    "min": 50,
    "max": 100,
    "step": 1,
    "help": "Applies when custom dimensions are enabled. Values are limited to the selected model's supported range."
  },
  "safeTop": {
    "text": "Top safe area (px)",
    "type": "slider",
    "value": 100,
    "min": 0,
    "max": 1200,
    "step": 1,
    "help": "Applies when custom dimensions are enabled. Values are limited to the selected model's supported range."
  },
  "safeBottom": {
    "text": "Bottom safe area (px)",
    "type": "slider",
    "value": 100,
    "min": 0,
    "max": 1200,
    "step": 1,
    "help": "Applies when custom dimensions are enabled. Values are limited to the selected model's supported range."
  },
  "replay": {
    "type": "button",
    "text": "Replay motion",
    "value": "replay"
  },
  "settle": {
    "type": "button",
    "text": "Show current time",
    "value": "settle"
  }
}
