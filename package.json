{
  "name": "timeform-clock",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.cjs && node scripts/build-wallpaper.cjs",
    "test": "node --test",
    "check": "node scripts/build.cjs --check && node scripts/build-wallpaper.cjs --check",
    "dev": "node scripts/serve.cjs",
    "build:wallpaper": "node scripts/build-wallpaper.cjs",
    "build:lively": "node scripts/build-lively.cjs --publish",
    "check:lively": "node scripts/build-lively.cjs --publish --check"
  },
  "engines": {
    "node": ">=18"
  }
}
